/* Append to assets/aesthetic-cluster.css (bump the ?v= in cluster-template.mjs afterwards) */
.cluster-figure{margin:26px 0 0;max-width:840px}
.cluster-figure img{width:100%;height:auto;border:1px solid var(--line);border-radius:10px}
.cluster-figure figcaption{color:var(--muted);font-size:13px;margin-top:8px}
.cluster-source{color:var(--muted);font-size:14px}
.cluster-source a{color:var(--sage)}
